# Copy this file to .env.local and fill in the two values from your Supabase
# project: Dashboard → Project Settings → API.
#
# .env.local is gitignored (the `*.local` rule). Both values below are safe to
# expose in the browser — the anon key is publishable, and row-level security is
# what actually keeps one account's grades out of another's reach.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
